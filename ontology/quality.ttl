@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

<https://w3id.org/seaborne-crude/quality> a owl:Ontology ;
    dcterms:creator "Pau Colomé Diaz" ;
    dcterms:description "Module formalizing Crude quality terms: guaranteed and typical specification, measured qualities like API gravity, density, sulfur content and viscosity limits."@en,
        "Módulo que formaliza los términos de calidad del crudo: especificación garantizada y típica, calidades medidas como gravedad API, densidad, contenido de azufre y límites de viscosidad."@es ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Seaborne-Traded Crude Oil Ontology: Crude Quality Module"@en,
        "Ontología de Comercio Marítimo de Crudo: Módulo de Calidad del Crudo"@es ;
    owl:versionIRI <https://w3id.org/seaborne-crude/quality/0.1.0> ;
    owl:versionInfo "0.1.0" .

