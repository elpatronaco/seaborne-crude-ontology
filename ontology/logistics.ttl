@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://w3id.org/seaborne-crude#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

sc:isLoaded a owl:DatatypeProperty ;
    rdfs:label "is loaded"@en,
        "está cargado"@es ;
    rdfs:domain sc:Vessel ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the vehicle has crude oil cargo loaded in"@en,
        "Si el buque tiene carga de crudo cargada en sus bodegas"@es .

<https://w3id.org/seaborne-crude/logistics> a owl:Ontology ;
    dcterms:creator "Pau Colomé Diaz" ;
    dcterms:description "Module covering cargoes, tankers by AFRA size class (Aframax, Suezmax, VLCC), load/discharge ports, vessel nomination, Notice of Readiness (NOR), loading events, and laycan intervals using OWL-Time vocabulary."@en,
        "Módulo que cubre cargamentos, buques petroleros por clase AFRA (Aframax, Suezmax, VLCC), puertos de carga y descarga, nominación del buque, Notice of Readiness (NOR), eventos de carga e intervalos laycan mediante el vocabulario OWL-Time."@es ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Seaborne-Traded Crude Oil Ontology — Logistics & Laycan Module"@en,
        "Ontología de Comercio Marítimo de Crudo — Módulo de Logística y Laycan"@es ;
    owl:imports <http://www.w3.org/2006/time> ;
    owl:versionIRI <https://w3id.org/seaborne-crude/logistics/0.1.0> ;
    owl:versionInfo "0.1.0" .

sc:Aframax a owl:Class ;
    rdfs:label "Aframax"@en,
        "Aframax"@es ;
    rdfs:subClassOf sc:Vessel ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sc:Vessel [ a owl:Restriction ;
                        owl:onProperty sc:deadweightTonnage ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 80000.0 ] [ xsd:maxExclusive 120000.0 ] ) ] ] ) ] ;
    skos:definition "Cargo vessel of medium size designed to transport 80,000-120,000 DWT"@en,
        "Buque de carga de tamaño mediano diseñado para transportar entre 80,000 y 120,000 toneladas de peso muerto"@es .

sc:Suezmax a owl:Class ;
    rdfs:label "Suezmax"@en,
        "Suezmax"@es ;
    rdfs:subClassOf sc:Vessel ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sc:Vessel [ a owl:Restriction ;
                        owl:onProperty sc:deadweightTonnage ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 120000.0 ] [ xsd:maxExclusive 200000.0 ] ) ] ] ) ] ;
    skos:definition "Cargo vessel of medium-large size designed to transport 120,000-200,000 DWT"@en,
        "Buque de carga de tamaño mediano-grande diseñado para transportar entre 120,000 y 200,000 toneladas de peso muerto"@es .

sc:VLCC a owl:Class ;
    rdfs:label "VLCC"@en,
        "VLCC"@es ;
    rdfs:subClassOf sc:Vessel ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sc:Vessel [ a owl:Restriction ;
                        owl:onProperty sc:deadweightTonnage ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 200000.0 ] ) ] ] ) ] ;
    skos:altLabel "Very Large Crude Carrier"@en ;
    skos:definition "Very large crude carrier designed to transport 200,000 DWT or more"@en,
        "Buque petrolero de gran tamaño diseñado para transportar 200,000 toneladas de peso muerto o más"@es .

sc:deadweightTonnage a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "deadweight tonnage"@en,
        "tonelaje de peso muerto"@es ;
    rdfs:domain sc:Vessel ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum weight in metric tonnes that a vessel can safely carry, including cargo, fuel, and crew."@en,
        "Peso máximo en toneladas métricas que un buque puede transportar de forma segura, incluyendo carga, combustible y tripulación."@es .

sc:Vessel a owl:Class ;
    rdfs:label "Vessel"@en,
        "Buque"@es ;
    skos:definition "Cargo vehicle designed to transport goods across water bodies."@en,
        "Vehículo de cargamento diseñado para transportar bienes a través de cuerpos de agua"@es ;
    skos:scopeNote "In the scope of this ontology, vessels are assumed to be crude oil (dirty cargo) tankers - Clean product tankers are out of scope."@en,
        "En el alcance de esta ontología, se asume que los buques son petroleros de crudo (flete sucio) - Los buques de productos limpios quedan fuera del alcance."@es .

[] a owl:AllDisjointClasses ;
    owl:members ( sc:Aframax sc:Suezmax sc:VLCC ) .

[] a owl:AllDisjointClasses ;
    owl:members ( sc:Vessel sc:PhysicalCrudeContract sc:ContractDocument sc:Party sc:CargoQuantity sc:QuantityUnit ) .

