@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-der-cm-ctr: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/CommoditiesContracts/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fnd-agr-ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://w3id.org/seaborne-crude#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

sc:Barrel skos:exactMatch unit:BBL .

sc:CargoQuantity rdfs:subClassOf qudt:QuantityValue .

sc:ContractDocument rdfs:subClassOf fibo-fnd-agr-ctr:ContractDocument .

sc:GuaranteedSpecification rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment .

sc:IncotermRule rdfs:subClassOf fibo-fbc-fi-fi:StandardizedTerms .

sc:MetricTonne skos:exactMatch unit:TON_Metric .

sc:PhysicalCrudeContract rdfs:subClassOf fibo-fnd-agr-ctr:BilateralContract,
        fibo-fnd-agr-ctr:WrittenContract .

sc:QualitySpecification rdfs:subClassOf fibo-fnd-agr-ctr:ContractualElement .

sc:QuantityUnit rdfs:subClassOf qudt:Unit .

sc:SpotContract skos:closeMatch fibo-der-cm-ctr:CommoditySpotContract .

sc:TypicalSpecification rdfs:subClassOf fibo-fnd-agr-ctr:NonBindingTerm .

<https://w3id.org/seaborne-crude/alignments> a owl:Ontology ;
    dcterms:creator "Pau Colomé Diaz" ;
    dcterms:description "Bridge module aligning the seaborne-crude domain ontology with external vocabularies (QUDT, FIBO, PMDCo Logistics, and deferred GLEIF)."@en,
        "Módulo puente que alinea la ontología de comercio marítimo de crudo con vocabularios externos (QUDT, FIBO, PMDCo Logistics y GLEIF diferido)."@es ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Seaborne-Traded Crude Oil Ontology: External Alignments Module"@en,
        "Ontología de Comercio Marítimo de Crudo: Módulo de Alineamientos Externos"@es ;
    rdfs:comment "GLEIF: deferred to PEC4 (out of scope for Iteration 1). Align entities.ttl with GLEIF L1/L2 in PEC4."@en,
        "PMDCo Logistics: IRI alignment (locked). TODO(verify) — add verified PMDCo Logistics class/property IRIs once selected."@en,
        "QUDT, FIBO, and PMDCo Logistics use lightweight soft IRI alignment stubs without owl:imports."@en ;
    owl:versionIRI <https://w3id.org/seaborne-crude/alignments/0.1.0> ;
    owl:versionInfo "0.1.0" .

qudt:QuantityValue a owl:Class ;
    rdfs:label "Quantity Value (QUDT)"@en ;
    rdfs:comment "Verified QUDT class for numeric quantity-unit pairs."@en .

qudt:Unit a owl:Class ;
    rdfs:label "Unit (QUDT)"@en ;
    rdfs:comment "Verified QUDT base class for measurement units."@en .

unit:BBL a owl:NamedIndividual ;
    rdfs:label "Barrel (QUDT)"@en ;
    rdfs:comment "Verified QUDT unit IRI for oil/volume barrel."@en .

unit:TON_Metric a owl:NamedIndividual ;
    rdfs:label "Metric Ton (QUDT)"@en ;
    rdfs:comment "Verified QUDT unit IRI for metric tonne (1,000 kg; qudt:exactMatch unit:TONNE in QUDT)."@en .

fibo-der-cm-ctr:CommoditySpotContract a owl:Class ;
    rdfs:label "Commodity Spot Contract (FIBO)"@en ;
    rdfs:comment "Verified FIBO DER class; aligned via skos:closeMatch only to avoid importing financial-instrument axioms."@en .

fibo-fbc-fi-fi:StandardizedTerms a owl:Class ;
    rdfs:label "Standardized Terms (FIBO)"@en ;
    rdfs:comment "Verified FIBO FBC class for standardized contract terms published by an organization and incorporated by reference."@en .

fibo-fnd-agr-ctr:BilateralContract a owl:Class ;
    rdfs:label "Bilateral Contract (FIBO)"@en ;
    rdfs:comment "Verified FIBO FND class for two-party written contracts."@en .

fibo-fnd-agr-ctr:ContractDocument a owl:Class ;
    rdfs:label "Contract Document (FIBO)"@en ;
    rdfs:comment "Verified FIBO FND class for legal documents recording formal contract terms."@en .

fibo-fnd-agr-ctr:ContractualCommitment a owl:Class ;
    rdfs:label "Contractual Commitment (FIBO)"@en ;
    rdfs:comment "Verified FIBO FND class for a binding provision specifying something the contracting parties agree to fulfill."@en .

fibo-fnd-agr-ctr:ContractualElement a owl:Class ;
    rdfs:label "Contractual Element (FIBO)"@en ;
    rdfs:comment "Verified FIBO FND class for an arrangement, provision, requirement, rule, specification, or standard forming part of an agreement."@en .

fibo-fnd-agr-ctr:NonBindingTerm a owl:Class ;
    rdfs:label "Non-Binding Term (FIBO)"@en ;
    rdfs:comment "Verified FIBO FND class for a contractual element that is not legally binding on any party."@en .

fibo-fnd-agr-ctr:WrittenContract a owl:Class ;
    rdfs:label "Written Contract (FIBO)"@en ;
    rdfs:comment "Verified FIBO FND class for formal contracts written and signed by the parties."@en .

